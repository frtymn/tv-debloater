{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/frtymn/tv-debloater/db/db/packages.schema.json",
  "title": "TV Debloater package safety database",
  "description": "Schema 2. Unknown fields are allowed and ignored by the app. Limits match DbValidator.kt.",
  "type": "object",
  "required": ["schemaVersion", "dbVersion", "packages"],
  "properties": {
    "schemaVersion": { "type": "integer", "minimum": 1, "maximum": 2 },
    "dbVersion": { "type": "integer", "minimum": 0, "description": "Monotonic. Bumped by tools/db_build.py publish." },
    "publishedAt": { "type": "string", "maxLength": 64, "description": "UTC ISO-8601, e.g. 2026-11-09T12:00:00Z" },
    "minAppVersion": { "type": "string", "maxLength": 64, "pattern": "^$|^v?[0-9]+(\\.[0-9]+){0,2}([-+].*)?$" },
    "device": { "type": "string", "maxLength": 200 },
    "devices": {
      "type": "array", "maxItems": 20,
      "description": "Device models (getprop ro.product.model) the list was verified on.",
      "items": { "type": "string", "minLength": 1, "maxLength": 64 }
    },
    "packages": {
      "type": "array", "minItems": 1, "maxItems": 2000,
      "items": { "$ref": "#/$defs/entry" }
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "required": ["packageName", "level", "sources"],
      "properties": {
        "packageName": { "type": "string", "maxLength": 255, "pattern": "^[A-Za-z][A-Za-z0-9_]*(\\.[A-Za-z0-9_]+)*$" },
        "level": { "enum": ["SAFE", "CAUTION", "PROTECTED"] },
        "label": { "type": "string", "maxLength": 80 },
        "descriptionEn": { "type": "string", "maxLength": 600 },
        "descriptionTr": { "type": "string", "maxLength": 600 },
        "sources": {
          "type": "array", "minItems": 1, "maxItems": 10,
          "items": { "type": "string", "pattern": "^https://", "maxLength": 300 }
        },
        "aggressive": { "type": "boolean", "description": "Preselected by the aggressive profile. CAUTION only." },
        "verifiedOn": {
          "type": "array", "maxItems": 10,
          "items": {
            "type": "object", "required": ["model"],
            "properties": {
              "model": { "type": "string", "minLength": 1, "maxLength": 64 },
              "android": { "type": "string", "maxLength": 64 },
              "date": { "type": "string", "maxLength": 64 }
            }
          }
        },
        "devices": { "type": "array", "maxItems": 20, "items": { "type": "string", "minLength": 1, "maxLength": 64 } },
        "notes": { "type": "string", "maxLength": 600 }
      }
    }
  }
}
